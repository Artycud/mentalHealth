{
  "name": "cud-mental-health-week",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:dates": "node --experimental-strip-types --no-warnings scripts/test-thai-date.mjs",
    "check:booth": "node --experimental-strip-types --no-warnings scripts/check-booth-scoring.mjs",
    "test:scoring": "node --experimental-strip-types --no-warnings scripts/test-scoring.mjs",
    "test:look": "node scripts/e2e-look.mjs",
    "test:e2e": "node --experimental-strip-types --no-warnings scripts/e2e-phone.mjs",
    "test:admin": "node --experimental-strip-types --no-warnings scripts/test-admin.mjs",
    "admin:reset": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings scripts/admin-reset.mjs",
    "admin:setup": "node --experimental-strip-types --no-warnings scripts/admin-setup.mjs",
    "test:setup:e2e": "node --experimental-strip-types --no-warnings scripts/e2e-setup.mjs",
    "test:admin:e2e": "node --experimental-strip-types --no-warnings scripts/e2e-admin.mjs",
    "test:auth": "node --experimental-strip-types --no-warnings scripts/test-auth.mjs",
    "test:db": "node --experimental-strip-types --no-warnings scripts/test-db.mjs",
    "docs:guide": "node scripts/make-guide-pdf.mjs",
    "textures": "node scripts/make-textures.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup-db.mjs",
    "db:reset": "node -e \"for(const f of ['app.db','app.db-journal','app.db-wal','app.db-shm'])require('fs').rmSync('data/'+f,{force:true});console.log('data/app.db removed')\"",
    "check:theme": "node --no-warnings scripts/check-theme.mjs",
    "test:moment": "node --experimental-strip-types --no-warnings scripts/test-new-flowers.mjs",
    "test:vent": "node --experimental-strip-types --no-warnings scripts/test-vent.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "puppeteer-core": "^25.11.0",
    "typescript": "^5"
  }
}
